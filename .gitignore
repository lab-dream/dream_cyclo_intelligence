# ────────────────────────────────────────────────────────────
# Docker
# ────────────────────────────────────────────────────────────
.env
# Trailing-slash patterns ignore directories only — drop the slash so
# the same patterns also catch symlinks (used when the bind-mount
# target is relocated to an external SSD via
# docker/relocate_workspace_to_ssd.sh).
docker/workspace
docker/huggingface
docker/zenoh_cache

# Runtime-authored navigation mission XML.
# Keep these files local to each robot/workspace; never include them in commits.
/docker/workspace/navigation/

# Per-backend runtime workspaces — model checkpoints / HF cache
# downloaded at inference time. Bind-mounted into the policy
# container at /workspace.
cyclo_brain/policy/lerobot/workspace/
cyclo_brain/policy/groot/workspace/
cyclo_brain/policy/lerobot/checkpoints/
cyclo_brain/policy/groot/checkpoints/

# ────────────────────────────────────────────────────────────
# IDE / OS
# ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ────────────────────────────────────────────────────────────
# Claude Code local workspace
# ────────────────────────────────────────────────────────────
.claude/
.sixth/

# ────────────────────────────────────────────────────────────
# Scratch / draft dev docs
# ────────────────────────────────────────────────────────────
*_IMPLEMENTATION.md
*_TEST_REPORT.md
*_DESIGN.md

# Local reports and experiments. Keep implementation, runtime configs, and
# regression tests tracked; put new experiment outputs in these directories.
reports/
report/
experiments/
experiment/
benchmarks/
benchmark_results/
verification/
validation_results/
*_REPORT.*
*_report.md
*_report.html
report_*.md
report_*.html
report_*.json
*_benchmark.json
*_validation.json
*.log

# Local report bundles and one-off DLS measurement/rendering scripts.
/docs/chunkrl_integration/
/cyclo_brain/sdk/dls_ik/scripts/
/cyclo_brain/sdk/dls_ik/config/ffw_sg2_follower_90deg_initial_positions.yaml

