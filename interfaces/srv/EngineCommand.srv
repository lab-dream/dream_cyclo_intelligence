########################################
# Internal Main <-> Engine process commands
########################################
# Hosted by the policy container's Engine process at /<backend>/engine_command.
# External clients should keep using /<backend>/inference_command.

uint8 LOAD_POLICY   = 0
uint8 GET_ACTION    = 1
uint8 UNLOAD_POLICY = 2
uint8 LOAD_DATASET_SIMULATION = 3
uint8 STEP_DATASET_SIMULATION = 4
uint8 UNLOAD_DATASET_SIMULATION = 5

uint8 command

# Monotonic request id generated by Main. Engine echoes it back so Main can
# discard late/stale responses after a configurable timeout.
uint64 seq_id

# LOAD_POLICY fields.
string model_path
string embodiment_tag
string robot_type
string task_instruction
string acceleration_mode
string acceleration_engine_path
float64 inference_hz
# Dataset simulation only: JSON with dataset_path, episode, and initial frame.
string simulation_config

# Relative EEF IK: cyclo_control (default), nodeik (.pt model), dls (elbow null-space).
string ik_backend
string ik_model_path
string arm_selection
string action_request_mode
string chunkrl_checkpoint
# Reset state on start/resume, discarded startup target, or failed request.
bool reset_policy_state
---
uint64 seq_id
bool success
string message

# LOAD_POLICY response.
string[] action_keys

# GET_ACTION response. action_list is row-major:
# chunk_size * action_dim == len(action_list).
int32 chunk_size
int32 action_dim
float64[] action_list
# Dataset simulation only: joints, dataset images, and relative/absolute EEF poses.
string simulation_state
